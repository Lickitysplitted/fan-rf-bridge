# ESPHome build output and secrets (copy secrets.example.yaml -> secrets.yaml)
/.esphome/
/secrets.yaml

# Claude Code local settings
/.claude/

# HackRF IQ files: large, regenerated by make_fana_iq.py / make_fanb_iq.py
*.cs8

# Local log captures
/rxlog.*

# Personal notes (room names)
/fan map.txt

# Third-party binaries and docs: download from the source instead (see README)
/tools/
/wESP32-Product-Brief.pdf

# KiCad local state, backups and plot output
/pcb/.history/
/pcb/*.kicad_prl
/pcb/*-backups/
/pcb/fp-info-cache
/pcb/gerbers/
/pcb/check_*.rpt
